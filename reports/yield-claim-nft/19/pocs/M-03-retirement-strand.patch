+// =============================================================================
+// PART 5 — CONTRAST ARM: the ECON-001 safe-config recipe recovers 100% of it.
+//          This is what makes the finding actionable.
+// =============================================================================
+contract M03_SafeConfigRecipeWorks is M03Base {
+    function test_M03_5_safeConfigRecipeRecoversTheWholeBuffer() public {
+        uint256 stranded = _accumulateSteadyState();
+        uint256 potBefore = usdc.balanceOf(address(batch));
+
+        BatchNFTMinterMultiToken newBatch = new BatchNFTMinterMultiToken(owner);
+        newBatch.setTokenMinter(IStakingTokenMinterV2(address(nftMinter)));
+        newBatch.setDispatcherIndex(PAY_INDEX);
+        newBatch.setNudgeTokenWhitelist(address(usdc), true);
+        newBatch.setNudgeStreamer(address(streamer));
+        streamer.registerStream(address(newBatch), address(usdc), D);
+
+        // (a) repoint the DONOR first, so donations stop feeding the old pair
+        ratchet.setBatchMinter(address(newBatch));
+
+        // (b) wait >= duration
+        vm.warp(block.timestamp + D + 1);
+
+        // (c) read pendingStream and confirm it is the whole buffer
+        uint256 pending = streamer.pendingStream(address(batch), address(usdc));
+        assertEq(pending, stranded, "(c) pendingStream == whole buffer");
+
+        // (d) ONE batchMint(1, ...) on the OLD instance flushes it
+        payToken.mint(address(0x0F5E), MINT_PRICE);
+        vm.startPrank(address(0x0F5E));
+        payToken.approve(address(batch), MINT_PRICE);
+        batch.batchMint(1, address(0x0F5E), MINT_PRICE, _mins(0));
+        vm.stopPrank();
+        assertEq(usdc.balanceOf(address(streamer)), 0, "(d) streamer fully drained");
+        assertEq(usdc.balanceOf(address(batch)), potBefore + stranded, "(d) whole buffer landed on the old pot");
+
+        // (e) rescueERC20 the proceeds
+        uint256 all = usdc.balanceOf(address(batch));
+        batch.rescueERC20(IERC20(address(usdc)), address(newBatch), all);
+        assertEq(usdc.balanceOf(address(newBatch)), potBefore + stranded, "(e) 100% recovered");
+
+        // ONLY THEN retire.
+        batch.setDispatcherIndex(0);
+        batch.setNudgeTokenWhitelist(address(usdc), false);
+
+        emit log_named_uint("M-03 recovered by the SAFE recipe (USDC 6dp)", all);
+        emit log_named_uint("M-03 delta vs the naive script (USDC 6dp)", stranded);
+    }
+}
+
+// =============================================================================
+// PART 6 — HONESTY / SCOPE CORRECTION (material to severity).
+//
+//   ECON-001 states the streamer buffer becomes "unreachable forever" once any
+//   ONE of the four tidy-ups lands. That is TOO STRONG. `registerStream`
+//   settles the accrued stream to the batchMinter BEFORE resetting the window
+//   (NudgeStreamer.sol:118 `_settle(s, batchMinter, token)`), so an owner who
+//   knows the trick can re-register with duration = 1, wait one second,
+//   re-register again, and the WHOLE buffer is pushed onto the old batch-minter
+//   — from where `rescueERC20` extracts it. No batchMint required.
+//
+//   That back-door survives (A) setDispatcherIndex(0), (B) setTokenMinter(0)
+//   and (C) pause(). It is closed by exactly ONE of the four: unwhitelisting,
+//   because registerStream gates on `isNudgeToken`. And once USDC is
+//   unwhitelisted AND a pointer is unset, RE-whitelisting also reverts, because
+//   the add-branch calls `_resolvePaymentPath` (:253).
+//
+//   So the true terminal state is the PAIR
+//       setNudgeTokenWhitelist(USDC,false) + setDispatcherIndex(0)/setTokenMinter(0)
+//   applied in that order — which is exactly the order the migration template
+//   ("neutralize the old instance") encourages.
+// =============================================================================
+contract M03_RecoveryBackdoorAndTheTrueTerminalState is M03Base {
+    /// The undocumented back-door DOES work after setDispatcherIndex(0).
+    function test_M03_6a_registerStreamBackdoorRecoversAfterDispatcherUnset() public {
+        uint256 stranded = _accumulateSteadyState();
+        uint256 potBefore = usdc.balanceOf(address(batch));
+        batch.setDispatcherIndex(0);
+
+        // batchMint is dead...
+        payToken.mint(address(0xBEEF), MINT_PRICE);
+        vm.startPrank(address(0xBEEF));
+        payToken.approve(address(batch), MINT_PRICE);
+        vm.expectRevert(BatchNFTMinterMultiToken.BatchMint__DispatcherNotConfigured.selector);
+        batch.batchMint(1, address(0xBEEF), MINT_PRICE, _mins(0));
+        vm.stopPrank();
+
+        // ...but USDC is still whitelisted, so registerStream is still callable.
+        assertTrue(batch.isNudgeToken(address(usdc)), "TRIPWIRE: whitelist intact");
+        streamer.registerStream(address(batch), address(usdc), 1); // rate = buffer/1s
+        vm.warp(block.timestamp + 1);
+        streamer.registerStream(address(batch), address(usdc), 1); // settles the LOT
+
+        assertEq(usdc.balanceOf(address(streamer)), 0, "BACK-DOOR: buffer fully evacuated");
+        assertEq(
+            usdc.balanceOf(address(batch)) - potBefore, stranded, "BACK-DOOR: it landed on the retired batch-minter"
+        );
+
+        batch.rescueERC20(IERC20(address(usdc)), treasury, stranded);
+        assertEq(usdc.balanceOf(treasury), stranded, "BACK-DOOR: 100% recovered without batchMint");
+    }
+
+    /// Unwhitelisting closes the back-door too — this is the one that bites.
+    function test_M03_6b_unwhitelistClosesTheBackdoor_exactSelector() public {
+        uint256 stranded = _accumulateSteadyState();
+        batch.setNudgeTokenWhitelist(address(usdc), false);
+
+        vm.expectRevert(
+            abi.encodeWithSelector(
+                NudgeStreamer.NudgeStreamer__NotWhitelisted.selector, address(batch), address(usdc)
+            )
+        );
+        streamer.registerStream(address(batch), address(usdc), 1);
+
+        assertEq(usdc.balanceOf(address(streamer)), stranded, "buffer still stranded");
+    }
+
+    /// THE TERMINAL STATE: unwhitelist + unset pointer. Every exit is shut and
+    /// re-opening the whitelist reverts on the payment-path derivation.
+    function test_M03_6c_terminalState_everyExitIsShut() public {
+        uint256 stranded = _accumulateSteadyState();
+        _assertFlushPathIsLive(stranded);
+
+        // The two-step "neutralize the old instance" tidy-up.
+        batch.setNudgeTokenWhitelist(address(usdc), false);
+        batch.setDispatcherIndex(0);
+
+        // 1. batchMint: reverts before the flush.
+        payToken.mint(address(0xBEEF), MINT_PRICE);
+        vm.startPrank(address(0xBEEF));
+        payToken.approve(address(batch), MINT_PRICE);
+        vm.expectRevert(BatchNFTMinterMultiToken.BatchMint__DispatcherNotConfigured.selector);
+        batch.batchMint(1, address(0xBEEF), MINT_PRICE, _emptyMins());
+        vm.stopPrank();
+
+        // 2. registerStream back-door: gated on isNudgeToken.
+        vm.expectRevert(
+            abi.encodeWithSelector(
+                NudgeStreamer.NudgeStreamer__NotWhitelisted.selector, address(batch), address(usdc)
+            )
+        );
+        streamer.registerStream(address(batch), address(usdc), 1);
+
+        // 3. Re-open the whitelist to restore either path? Also reverts.
+        vm.expectRevert(BatchNFTMinterMultiToken.BatchMint__DispatcherNotConfigured.selector);
+        batch.setNudgeTokenWhitelist(address(usdc), true);
+
+        // 4. No rescue on the streamer.
+        assertFalse(_probeForRescue(address(streamer), treasury, stranded), "no rescue on NudgeStreamer");
+
+        // 5. The donor path is gone: the ratchet now feeds a different pair.
+        BatchNFTMinterMultiToken newBatch = new BatchNFTMinterMultiToken(owner);
+        newBatch.setTokenMinter(IStakingTokenMinterV2(address(nftMinter)));
+        newBatch.setDispatcherIndex(PAY_INDEX);
+        newBatch.setNudgeTokenWhitelist(address(usdc), true);
+        newBatch.setNudgeStreamer(address(streamer));
+        streamer.registerStream(address(newBatch), address(usdc), D);
+        ratchet.setBatchMinter(address(newBatch));
+        _mintThroughRatchet(address(0xD00D));
+        assertEq(usdc.balanceOf(address(streamer)), stranded + RATCHET_PRICE, "new donations do not touch the old pair");
+
+        emit log_named_uint("M-03 TERMINAL stranded amount (USDC 6dp)", stranded);
+    }
+}
