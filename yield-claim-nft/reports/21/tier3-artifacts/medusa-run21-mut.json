{
  "fuzzing": {
    "workers": 2,
    "workerResetLimit": 50,
    "timeout": 120,
    "testLimit": 0,
    "callSequenceLength": 100,
    "corpusDirectory": "medusa-run21-corpus-mut",
    "coverageEnabled": true,
    "coverageFormats": ["lcov"],
    "targetContracts": ["MedusaRun21MutM1"],
    "deployerAddress": "0x30000",
    "senderAddresses": ["0x10000", "0x20000", "0x30000"],
    "blockGasLimit": 1000000000,
    "transactionGasLimit": 500000000,
    "testing": {
      "stopOnFailedTest": false,
      "stopOnFailedContractMatching": false,
      "stopOnNoTests": true,
      "testAllContracts": false,
      "traceAll": false,
      "assertionTesting": { "enabled": false },
      "propertyTesting": { "enabled": true, "testPrefixes": ["property_"] },
      "optimizationTesting": { "enabled": false }
    },
    "chainConfig": { "codeSizeCheckDisabled": true }
  },
  "compilation": {
    "platform": "crytic-compile",
    "platformConfig": { "target": ".", "solcVersion": "", "exportDirectory": "", "args": ["--foundry-compile-all"] }
  },
  "logging": { "level": "info", "logDirectory": "medusa-run21-logs-mut", "noColor": true }
}
