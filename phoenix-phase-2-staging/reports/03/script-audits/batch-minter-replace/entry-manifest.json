{
  "entryPoint": "batch-minter-replace",
  "intentComment": "Story 050 — redeploy fixed BatchNFTMinter, repoint SYA + BalancerPoolerV2, seed nudge pot from BPT, retire old contract",
  "variants": {
    "preview": {
      "key": "batch-minter-replace:preview",
      "command": "PREVIEW_MODE=true forge script script/ReplaceBatchNFTMinter.s.sol:ReplaceBatchNFTMinter --rpc-url $RPC_MAINNET --sender 0xCad1a7864a108DBFF67F4b8af71fAB0C7A86D0B6 --slow -vvv",
      "broadcasts": false,
      "envFlags": ["PREVIEW_MODE=true", "--sender 0xCad1a7864a108DBFF67F4b8af71fAB0C7A86D0B6", "--slow"]
    },
    "broadcast": {
      "key": "batch-minter-replace",
      "command": "node scripts/backup-mainnet-addresses.js && forge script script/ReplaceBatchNFTMinter.s.sol:ReplaceBatchNFTMinter --rpc-url $RPC_MAINNET --broadcast --skip-simulation --slow --ledger --hd-paths \"m/44'/60'/46'/0/0\" -vvv && node scripts/patch-mainnet-addresses-batch-minter-replace.js",
      "broadcasts": true,
      "envFlags": ["--broadcast", "--skip-simulation", "--slow", "--ledger", "--hd-paths m/44'/60'/46'/0/0"]
    }
  },
  "forgeTarget": {
    "file": "script/ReplaceBatchNFTMinter.s.sol",
    "contract": "ReplaceBatchNFTMinter",
    "entryFn": "run"
  },
  "jsChain": {
    "pre": [
      {
        "script": "scripts/backup-mainnet-addresses.js",
        "reads": ["server/deployments/mainnet-addresses.ts"],
        "writes": ["server/deployments/mainnet.backup.<timestamp>.ts"],
        "note": "snapshot copy of the mainnet address registry before broadcast; runs only on the broadcast variant"
      }
    ],
    "post": [
      {
        "script": "scripts/patch-mainnet-addresses-batch-minter-replace.js",
        "reads": ["server/deployments/progress.batch-minter-replace.1.json"],
        "writes": ["server/deployments/mainnet-addresses.ts"],
        "note": "rewrites BOTH 'BatchNFTMinter' and 'NudgeBatchNFTMinter' keys to the freshly-deployed minter address read from the progress file; throws (refuses to write) if BatchNFTMinter key absent; runs only on the broadcast variant"
      }
    ]
  },
  "chainId": 1,
  "chainIdSource": "no on-chain require(block.chainid==1); inferred from --rpc-url $RPC_MAINNET, hardcoded mainnet address constants, and progress JSON literal chainId:1"
}
