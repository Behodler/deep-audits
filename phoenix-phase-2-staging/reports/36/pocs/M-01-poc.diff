+++ b/test/audit-run36/run-broadcast-tail.js
@@ -0,0 +1,47 @@
+#!/usr/bin/env node
+// run-36 audit PoC helper (NOT sponsor code) for M-01 / pps36m1.
+// Replays the EXACT `&&` tail that `npm run stable-staker-v2-cutover:broadcast` runs after its forge step,
+// read verbatim from package.json (never retyped), against whatever progress file is on disk.
+// `npm` is shadowed by a PATH shim that only records its argv and exits 0, so if the chain ever reached
+// `npm run stable-staker-v2-cutover:verify` / `:preview` it is recorded and nothing touches an RPC.
+// Prints one JSON object on stdout for the forge test (vm.tryFfi) to parse.
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const crypto = require('crypto');
+const { spawnSync } = require('child_process');
+
+const ROOT = process.cwd();
+const KEY = 'stable-staker-v2-cutover:broadcast';
+const FORGE = 'forge script script/CutoverStableStakerV2Mainnet.s.sol:CutoverStableStakerV2Mainnet';
+const ADDR = path.join(ROOT, 'server', 'deployments', 'mainnet-addresses.ts');
+
+const full = JSON.parse(fs.readFileSync(path.join(ROOT, 'package.json'), 'utf8')).scripts[KEY];
+const f = full.indexOf(FORGE);
+if (f < 0) throw new Error('forge step not found in ' + KEY);
+const sep = full.indexOf(' && ', f);
+const tail = full.slice(sep + 4); // everything the shell runs only if forge exited 0
+
+const sha = () => crypto.createHash('sha256').update(fs.readFileSync(ADDR)).digest('hex');
+const shaBefore = sha();
+
+const shim = fs.mkdtempSync(path.join(os.tmpdir(), 'poc36-npm-'));
+const sentinel = path.join(shim, 'npm-calls.log');
+fs.writeFileSync(path.join(shim, 'npm'), `#!/usr/bin/env bash\necho "npm $*" >> "${sentinel}"\nexit 0\n`, { mode: 0o755 });
+
+const r = spawnSync('bash', ['-c', tail], {
+    cwd: ROOT,
+    encoding: 'utf8',
+    env: { ...process.env, PATH: `${shim}:${process.env.PATH}` },
+});
+const npmCalls = fs.existsSync(sentinel) ? fs.readFileSync(sentinel, 'utf8').trim() : '';
+fs.rmSync(shim, { recursive: true, force: true });
+
+process.stdout.write(JSON.stringify({
+    tail,
+    exitCode: r.status === null ? 255 : r.status,
+    stdout: r.stdout.trim(),
+    stderr: r.stderr.trim(),
+    npmCalls,
+    addressesUnchanged: sha() === shaBefore ? 'true' : 'false',
+}));
diff --git a/test/audit-run36/run-poc.sh b/test/audit-run36/run-poc.sh
