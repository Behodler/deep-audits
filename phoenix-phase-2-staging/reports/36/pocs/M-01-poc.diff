+++ b/test/audit-run36/run-poc.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# run-36 audit PoC runner (NOT sponsor code) for M-01 / pps36m1. Fork test only: no anvil, no broadcast.
+# Snapshots and restores every file the PoC can touch, even on failure.
+set -u
+W="$(cd "$(dirname "$0")/../.." && pwd)"
+cd "$W"
+set -a; . /home/justin/code/audits/.envrc >/dev/null 2>&1; set +a
+[ -n "${RPC_MAINNET:-}" ] || { echo "RPC_MAINNET unset (check /home/justin/code/audits/.envrc)"; exit 1; }
+if ! cast block-number --rpc-url "$RPC_MAINNET" >/dev/null 2>&1; then
+  echo "ALERT: RPC_MAINNET liveness probe failed - key may be expired"; exit 1
+fi
+PROG=server/deployments/progress.stable-staker-v2-cutover.1.json
+ADDR=server/deployments/mainnet-addresses.ts
+SNAP="$(mktemp -d)"
+cp "$ADDR" "$SNAP/addr.ts"
+[ -e "$PROG" ] && { echo "refusing: $PROG already exists"; exit 1; }
+restore() {
+  cp "$SNAP/addr.ts" "$ADDR"
+  rm -f "$PROG"
+  rm -rf "$SNAP"
+}
+trap restore EXIT
+FOUNDRY_PROFILE=audit36 forge test --skip 'test/audit-run3[1-5]*' \
+  --match-path test/audit-run36/M01PendingTailPoC.t.sol -vv "$@"
